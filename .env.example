# SAP S/4HANA connection settings
# Copy this file to .env and fill in your values

# Base URL of your SAP system, e.g.:
#   On-premise: https://my-sap-host:44300
#   SAP BTP/Cloud: https://my-tenant.s4hana.ondemand.com
SAP_BASE_URL=https://your-sap-host:44300

# SAP dialog user credentials
SAP_USER=your_username
SAP_PASSWORD=your_password

# SAP client / Mandant (default: 100)
SAP_CLIENT=100

# Set to "false" to disable SSL certificate verification (not recommended for production)
SAP_SSL_VERIFY=true
