{
  "name": "railflow-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "api": "node server/index.js",
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run api\" \"vite --host 0.0.0.0\"",
